{
  "name": "kipos",
  "version": "0.0.0",
  "description": "A tactile Greek garden for React: a raised stone bed and whitewashed tins that grow over real days, wilt when you forget them and perk up when you water.",
  "license": "MIT",
  "author": "Nick <nick@zonnioshunt.com.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickzonzh/object-studies.git",
    "directory": "packages/kipos"
  },
  "homepage": "https://github.com/nickzonzh/object-studies/tree/main/packages/kipos#readme",
  "bugs": "https://github.com/nickzonzh/object-studies/issues",
  "keywords": [
    "react",
    "garden",
    "plants",
    "idle",
    "skeuomorphic",
    "component"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/finalize-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack --profile esm-only"
  },
  "dependencies": {
    "object-studies-core": "^0.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
