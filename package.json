{
  "name": "korniza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/finalize-library.mjs",
    "prepack": "npm run typecheck && npm run build:lib",
    "check": "npm run build && npm run build:lib"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "description": "Six dimensional React frames for images and arbitrary content.",
  "license": "UNLICENSED",
  "files": [
    "dist-lib",
    "QA.md"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": {
      "types": "./dist-lib/style.css.d.ts",
      "default": "./dist-lib/style.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nickzonzh/korniza.git"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
